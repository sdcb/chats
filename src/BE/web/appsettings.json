{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "None",
      "Chats.BE.Controllers.OpenAICompatible.OpenAICompatibleController": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FE_URL": "http://localhost:3001",
  "ENCRYPTION_PASSWORD": "this is used for encrypt auto increment int id, please set as a random string.",
  "DBType": "sqlite", // sqlite | mssql | postgresql
  "ConnectionStrings": {
    "ChatsDB": "Data Source=./AppData/chats.db"
  },
  "CodePod": {
    "WorkDir": "/app",
    "ArtifactsDir": "artifacts",
    "LabelPrefix": "codepod",
    "OutputOptions": {
      "MaxOutputBytes": 8192 // 8KB
    }
  },
  "CodeInterpreterPolicy": {
    "DefaultTimeoutSeconds": 300,
    "SessionIdleTimeoutSeconds": 1800,
    "MaxArtifactsFilesToUpload": 50,
    "MaxSingleUploadBytes": 157286400,
    "MaxTotalUploadBytesPerTurn": 314572800
  },
  "RequestTraceQueue": {
    "Capacity": 1000
  },
  "RequestTraceCleanup": {
    "Enabled": true
  },
  "JwtValidPeriod": "1.00:00:00",
  "JwtSecretKey": null,
  "Chat": {}
}
